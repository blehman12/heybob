<div style="font-family: Arial, Helvetica, sans-serif; max-width: 600px; color:#222;">
  <h2 style="margin:0 0 4px;">New RSVP for <%= @event.name %></h2>
  <p style="color:#666; margin:0 0 16px;"><%= (@event.display_date_range rescue @event.event_date&.strftime('%B %-d, %Y')) %></p>

  <table style="border-collapse:collapse; width:100%; margin-bottom:8px;">
    <tr><td style="padding:4px 8px; font-weight:bold; width:120px;">Name</td><td style="padding:4px 8px;"><%= @participant.display_name %></td></tr>
    <tr><td style="padding:4px 8px; font-weight:bold;">Response</td><td style="padding:4px 8px;"><%= (@participant.rsvp_status_display rescue @participant.rsvp_status.to_s.humanize) %></td></tr>
    <% if @participant.display_email.present? %>
      <tr><td style="padding:4px 8px; font-weight:bold;">Email</td><td style="padding:4px 8px;"><%= @participant.display_email %></td></tr>
    <% end %>
    <% if @participant.display_phone.present? %>
      <tr><td style="padding:4px 8px; font-weight:bold;">Phone</td><td style="padding:4px 8px;"><%= @participant.display_phone %></td></tr>
    <% end %>
  </table>

  <% answers = @participant.rsvp_answers.is_a?(Hash) ? @participant.rsvp_answers : {} %>
  <% shown = (@event.custom_questions || []).select { |q| q.is_a?(Hash) && answers[q['id'].to_s].present? } %>
  <% if shown.any? %>
    <h3 style="margin:16px 0 4px;">Their answers</h3>
    <ul style="margin:0 0 8px; padding-left:18px;">
      <% shown.each do |q| %>
        <li style="margin-bottom:4px;"><strong><%= q['question'] %></strong><br><%= answers[q['id'].to_s] %></li>
      <% end %>
    </ul>
  <% end %>

  <p style="margin:20px 0;">
    <a href="<%= admin_event_url(@event) %>" style="background:#0d6efd; color:#ffffff; padding:10px 16px; text-decoration:none; border-radius:6px; display:inline-block;">View all RSVPs</a>
  </p>
  <p style="color:#999; font-size:12px; margin:0;"><%= @event.event_participants.count %> total RSVP(s) so far · You can turn these emails off on the event's edit page.</p>
</div>
